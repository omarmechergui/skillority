# Backup outside the project
Copy-Item .gitignore "$env:TEMP\skillority-gitignore-backup"

# Clean .gitignore
@'
# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/

# Production builds
dist/
build/

# Environment variables and secrets
.env
.env.*
!.env.example

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Prisma local databases
backend/prisma/*.db
backend/prisma/*.db-journal

# Test artifacts
coverage/
test-results/
playwright-report/
playwright/.cache/

# OS files
.DS_Store
Thumbs.db

# Local database diagnostic scripts
/diagnose-db.js
/test-atlas-tcp.js
/test-prisma-live.js
/test-real-crud.js
'@ | Set-Content -LiteralPath .gitignore -Encoding UTF8

Write-Host "Gitignore cleaned successfully." -ForegroundColor Green