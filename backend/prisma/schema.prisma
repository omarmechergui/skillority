datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  STUDENT
  COMPANY
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum OpportunityType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum TransactionType {
  CREDIT_BONUS
  CHAPTER_UNLOCK
  QUIZ_REWARD
  DAILY_LOGIN
  DAILY_MISSION
  AD_REWARD
  ADMIN_ADJUSTMENT
}

enum CertificateType {
  COURSE_COMPLETION
  FINAL_ASSESSMENT
}

// -------------------------------------------------------------
// USER & AUTHENTICATION
// -------------------------------------------------------------

model User {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  email            String          @unique
  passwordHash     String
  role             Role
  isVerified       Boolean         @default(false)
  isActive         Boolean         @default(true)
  tokenVersion     Int             @default(0) // Enables immediate session invalidation
  invitedByAdminId String?         @db.ObjectId
  profile          Profile?
  wallet           Wallet?
  coursesAuthored  Course[]        @relation("InstructorCourses")
  enrollments      Enrollment[]
  applications     Application[]
  careerGoals      StudentCareerGoal[] @relation("StudentCareerGoals")
  companyOpportunities Opportunity[]    @relation("CompanyOpportunities")
  studentInterviews  Interview[]         @relation("StudentInterviews")
  companyInterviews  Interview[]         @relation("CompanyInterviews")
  studentOffers      Offer[]             @relation("StudentOffers")
  companyOffers      Offer[]             @relation("CompanyOffers")
  posts            CommunityPost[]
  comments         Comment[]
  quizAttempts     QuizAttempt[]
  assessmentAttempts AssessmentAttempt[]
  certificates     Certificate[]
  notifications    Notification[]
  sentMessages     Message[]       @relation("SenderMessages")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Profile {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  avatar             String?
  bio                String?
  skills             String[] @default([])
  // Student-specific fields
  university         String?
  major              String?
  graduationYear     Int?
  interests          String[] @default([])
  learningGoals      String?
  // Company / Recruiter-specific fields
  companyName        String?
  companyDescription String?
  industry           String?
  companySize        String?
  website            String?
  // Instructor-specific fields
  expertise          String[] @default([])
  experience         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AdminInvitation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  tokenHash   String   @unique
  role        Role     @default(INSTRUCTOR)
  createdById String   @db.ObjectId
  isAccepted  Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

// -------------------------------------------------------------
// COURSES, CHAPTERS & LESSONS
// -------------------------------------------------------------

model Course {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  instructorId    String          @db.ObjectId
  instructor      User            @relation("InstructorCourses", fields: [instructorId], references: [id])
  title           String
  description     String
  thumbnail       String?
  category        String
  level           String
  tags            String[]        @default([])
  status          CourseStatus    @default(DRAFT)
  reviewNote      String?
  chapters        Chapter[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  finalAssessment Json?           // Final assessment definitions & questions
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, category])
  @@index([instructorId])
}

model Chapter {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String        @db.ObjectId
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int           // Chapters 0-5 free; Chapter 6+ requires coins
  isFree    Boolean       @default(false)
  coinsCost Int           @default(0)
  lessons   Lesson[]
  quiz      Json?         // Structured chapter quiz JSON definition
  attempts  QuizAttempt[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Lesson {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  chapterId String   @db.ObjectId
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  content   Json     // Hybrid rich blocks: text, code, video, callout
  order     Int
  duration  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String   @db.ObjectId
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedLessonIds String[] @default([])
  unlockedChapterIds String[] @default([])
  progressPercent    Float    @default(0.0)
  isCompleted        Boolean  @default(false)
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, courseId])
}

// -------------------------------------------------------------
// QUIZZES, ASSESSMENTS & CERTIFICATES
// -------------------------------------------------------------

model QuizAttempt {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId    String   @db.ObjectId
  chapter      Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  score        Int      // Percentage
  passed       Boolean
  coinsAwarded Int      @default(0)
  answers      Json     // Answer map
  createdAt    DateTime @default(now())
}

model AssessmentAttempt {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String   @db.ObjectId
  score             Int
  passed            Boolean
  certificateIssued Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Certificate {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  recipientId  String          @db.ObjectId
  recipient    User            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  courseId     String          @db.ObjectId
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type         CertificateType // COURSE_COMPLETION vs FINAL_ASSESSMENT
  credentialId String          @unique
  issuedAt     DateTime        @default(now())
}

// -------------------------------------------------------------
// COINS & WALLET
// -------------------------------------------------------------

model Wallet {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  userId         String              @unique @db.ObjectId
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Int                 @default(100)
  transactions   WalletTransaction[]
  lastLoginBonus DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model WalletTransaction {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  walletId    String          @db.ObjectId
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Int
  type        TransactionType
  description String
  referenceId String?
  createdAt   DateTime        @default(now())

  @@index([walletId, createdAt])
  @@index([referenceId])
  @@index([walletId, type, createdAt])
}

// -------------------------------------------------------------
// CAREERS, OPPORTUNITIES & RECRUITMENT
// -------------------------------------------------------------

model CareerPath {
  id                      String              @id @default(auto()) @map("_id") @db.ObjectId
  title                   String
  slug                    String              @unique
  description             String
  category                String
  industry                String?
  difficultyLevel         String              @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedDuration       String?             // e.g. "6-9 months"
  requiredSkills          Json                // [{ name, proficiency, importance, description, relatedCourses }]
  recommendedSkills       Json?               // [{ name, proficiency }]
  optionalSkills          Json?
  learningResources       Json?               // [{ title, url, type, isFree }]
  recommendedCourseIds    String[]            @default([])
  relatedCareerSlugs      String[]            @default([])
  salaryRange             String?
  jobOutlook              String?
  employmentOpportunities String?
  isActive                Boolean             @default(true)
  studentGoals            StudentCareerGoal[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

model StudentCareerGoal {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String      @db.ObjectId
  student      User        @relation("StudentCareerGoals", fields: [studentId], references: [id], onDelete: Cascade)
  careerPathId String      @db.ObjectId
  careerPath   CareerPath  @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  isPrimary    Boolean     @default(true)
  targetDate   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([studentId, careerPathId])
}

model Opportunity {
  id                      String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId               String          @db.ObjectId
  company                 User?           @relation("CompanyOpportunities", fields: [companyId], references: [id], onDelete: Cascade)
  title                   String
  description             String
  type                    OpportunityType @default(INTERNSHIP)
  category                String?
  industry                String?
  location                String
  workplaceType           String          @default("REMOTE") // REMOTE, ONSITE, HYBRID
  duration                String?
  startDate               DateTime?
  deadline                DateTime?
  positions               Int             @default(1)
  filledPositions         Int             @default(0)
  skills                  String[]        @default([])
  optionalSkills          String[]        @default([])
  educationalRequirements String?
  experienceLevel         String?
  responsibilities        String[]        @default([])
  benefits                String[]        @default([])
  stipend                 String?
  eligibility             String?
  status                  String          @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED
  isOpen                  Boolean         @default(true)
  publishedAt             DateTime?
  applications            Application[]
  interviews              Interview[]
  offers                  Offer[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model Application {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  opportunityId   String                @db.ObjectId
  opportunity     Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentId       String                @db.ObjectId
  student         User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          ApplicationStatus     @default(PENDING)
  notes           String?
  resumeUrl       String?
  coverLetter     String?
  portfolioUrl    String?
  githubUrl       String?
  linkedinUrl     String?
  answers         Json?
  candidateSkills String[]              @default([])
  matchScore      Int?
  matchAnalysis   Json?
  internalNotes   String?               // Strictly company-private notes
  rating          Int?                  // 1-5 rating by company
  rejectionReason String?
  withdrawnAt     DateTime?
  interviews      Interview[]
  offer           Offer?
  timeline        ApplicationTimeline[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([opportunityId, studentId])
}

model Interview {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String      @db.ObjectId
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  opportunityId String      @db.ObjectId
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentId     String      @db.ObjectId
  student       User        @relation("StudentInterviews", fields: [studentId], references: [id], onDelete: Cascade)
  companyId     String      @db.ObjectId
  company       User        @relation("CompanyInterviews", fields: [companyId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  timezone      String      @default("UTC")
  interviewType String      @default("TECHNICAL") // SCREENING, TECHNICAL, BEHAVIORAL, FINAL
  meetingLink   String?
  location      String?
  instructions  String?
  status        String      @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, RESCHEDULED
  feedback      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Offer {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId  String      @unique @db.ObjectId
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  opportunityId  String      @db.ObjectId
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentId      String      @db.ObjectId
  student        User        @relation("StudentOffers", fields: [studentId], references: [id], onDelete: Cascade)
  companyId      String      @db.ObjectId
  company        User        @relation("CompanyOffers", fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  stipend        String?
  startDate      DateTime?
  duration       String?
  conditions     String?
  expiresAt      DateTime?
  status         String      @default("PENDING") // PENDING, ACCEPTED, DECLINED, CANCELLED, EXPIRED
  declinedReason String?
  respondedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model ApplicationTimeline {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId   String      @db.ObjectId
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action          String
  fromStatus      String?
  toStatus        String?
  note            String?
  performedById   String?     @db.ObjectId
  performedByRole String?
  createdAt       DateTime    @default(now())
}

// -------------------------------------------------------------
// COMMUNITY, MESSAGING & NOTIFICATIONS
// -------------------------------------------------------------

model CommunityPost {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  authorId   String    @db.ObjectId
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  content    String
  tags       String[]  @default([])
  likesCount Int       @default(0)
  likedByIds String[]  @default([])
  comments   Comment[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Comment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  postId    String        @db.ObjectId
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String        @db.ObjectId
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Message {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  senderId       String   @db.ObjectId
  sender         User     @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String   @db.ObjectId
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([recipientId, createdAt])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
