# Skillority Backend Environment Variables Template
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://placeholder_user:placeholder_pass@cluster.mongodb.net/skillority?retryWrites=true&w=majority"

# Security — JWT Secrets
# Must be at least 32 characters long. In production, placeholder strings containing 'change_me' are strictly rejected.
# Generate secure keys via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_a_secure_random_key_of_at_least_32_characters"
JWT_REFRESH_SECRET="replace_with_another_secure_random_key_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client CORS
CLIENT_ORIGIN="http://localhost:3000"

