# Skillority Backend Environment Variables Template
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://placeholder_user:placeholder_pass@cluster.mongodb.net/skillority?retryWrites=true&w=majority"

# Security — JWT Secrets (Replace with secure random keys in production)
JWT_ACCESS_SECRET="skillority_development_access_secret_change_me_in_production"
JWT_REFRESH_SECRET="skillority_development_refresh_secret_change_me_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client CORS
CLIENT_ORIGIN="http://localhost:3000"

